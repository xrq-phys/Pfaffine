# AR executable.
AR=ar

# Compilers.
# GCC with G++ is the general choice on linux.
# Intel compilers recommended on Intel processors.
CC=gcc
CFLAGS=-O2
CXX=g++
CXXFLAGS=-std=c++11 \
    -fPIC -O3 -DMKL -DBLAS_EXTERNAL -DF77_COMPLEX_RET_INTEL
F90 = ifort
FFLAGS = -fPIC -O3 -implicitnone

# BLAS with GEMMT
LDFLAGS=-lmkl_rt

# PFAPACK
HAVE_GEMMT = 1
LFLAGS = $(LDFLAGS)
